[Unit]
Description=Anyst Service
Wants=network-online.target
After=network-online.target

[Service]
# Create this account with the packaged anyst.sysusers before enabling.
User=anyst
Group=anyst
WorkingDirectory=/var/anyst
ExecStart=/var/anyst/anyst -c /var/anyst/config.yaml
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=10s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LogsDirectory=anyst
LogsDirectoryMode=0700
Environment=ANYST_LOG_DIR=/var/log/anyst
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
